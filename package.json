{
  "name": "Vendor_portal",
  "version": "1.0.0",
  "dependencies": {
    "22": "^0.0.0",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap-cloud-sdk/util": "^4.6.0",
    "@sap/approuter": "22.0.1",
    "@sap/cds": "^9.9.1",
    "@sap/cds-dk": "^9.9.1",
    "@sap/low-code-event-handler": "^1.2.2",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4.13.0",
    "hdb": "^2.27.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "watch-purchseorder": "cds watch --open purchseorder/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "echo \"No tests to run\""
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "auth": {
        "strategy": "mock",
        "users": {
          "keerthana": {
            "id": "keerthanadevi.natarajan@distrelec.com",
            "roles": [
              "User"
            ]
          }
        },
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "CE_PURCHASEORDER_0001": {
        "kind": "odata",
        "model": "srv/external/CE_PURCHASEORDER_0001",
        "credentials": {
          "destination": "SAP_Purchaseorder_API"
        }
      },
      "html5-repo": true,
      "destinations": true,
      "workzone": true
    }
  },
  "lcap": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/purchseorder"
  ]
}

{
  "welcomeFile": "/index.html",
  "routes": [
    {
      "source": "^/service/Vendor_portalService/(.*)$",
      "target": "/service/Vendor_portalService/$1",
      "destination": "srv-api",
      "csrfProtection": true,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}
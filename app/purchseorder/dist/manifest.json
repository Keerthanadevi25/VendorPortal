{
	"_version": "1.84.0",
	"sap.app": {
		"id": "purchseorder",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.24.0",
			"toolsId": "a29487c0-fc00-4a80-84c2-32ce277a959f"
		},
		"dataSources": {
			"mainService": {
				"uri": "/service/Vendor_portalService/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.01"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"purchseorder-display": {
					"semanticObject": "purchseorder",
					"action": "display",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.148.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "purchseorder.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "PurchaseOrder_ERP1List",
					"target": "PurchaseOrder_ERP1List"
				},
				{
					"pattern": "PurchaseOrder_ERP1({key}):?query:",
					"name": "PurchaseOrder_ERP1ObjectPage",
					"target": "PurchaseOrder_ERP1ObjectPage"
				}
			],
			"targets": {
				"PurchaseOrder_ERP1List": {
					"type": "Component",
					"id": "PurchaseOrder_ERP1List",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/PurchaseOrder_ERP1",
							"variantManagement": "Page",
							"navigation": {
								"PurchaseOrder_ERP1": {
									"detail": {
										"route": "PurchaseOrder_ERP1ObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"PurchaseOrder_ERP1ObjectPage": {
					"type": "Component",
					"id": "PurchaseOrder_ERP1ObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/PurchaseOrder_ERP1"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "Vendor_portal.service"
	}
}